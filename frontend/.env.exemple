# ============================================================
# TEMPLATE FRONTEND — COPIER EN .env ET REMPLIR
# CE FICHIER NE DOIT CONTENIR AUCUNE VALEUR RÉELLE
# ============================================================

# URL de l'API backend
VITE_API_URL=http://localhost:3000/api

# Clé API partagée avec le backend (doit correspondre à API_KEY dans backend/.env)
VITE_API_KEY=CHANGE_ME_SAME_AS_BACKEND_API_KEY
