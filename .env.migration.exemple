# .env.migration — Variables pour le script de migration MongoDB → Supabase
# Copier en .env.migration et remplir les valeurs AVANT de lancer migrate_mongodb.js
# NE JAMAIS COMMITER ce fichier (ajouté dans .gitignore)

# MongoDB Atlas — URI de production (lecture seule recommandée)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/kucibok

# Supabase — URL du projet
SUPABASE_URL=https://VOTRE_REF.supabase.co

# Supabase — SERVICE ROLE KEY (pas la anon key — accès total bypass RLS)
# Disponible dans : Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
