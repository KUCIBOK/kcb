{
	"info": {
		"_postman_id": "kcb-collection-001",
		"name": "Kucibok API",
		"description": "Kucibok API — Infrastructure digitale de standardisation et de circulation securisee de l'art africain.\n\nAll routes go through a single Vercel catch-all function at `api/[...path].js`.\n\n**Response format:**\n- Success: `{ \"data\": ... }` (with optional `pagination` object)\n- Error: `{ \"error\": \"message\" }`\n\n**Authentication:**\n- `kcb-api-key` header on every request\n- `Authorization: Bearer <token>` for authenticated routes\n\n**Setup:** Run the \"Sign In\" request in folder 0 first to populate the auth_token variable.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{auth_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global pre-request: attach kcb-api-key header to every request",
					"pm.request.headers.upsert({",
					"    key: 'kcb-api-key',",
					"    value: pm.environment.get('api_key')",
					"});"
				]
			}
		}
	],
	"variable": [
		{
			"key": "artwork_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "artist_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "profile_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "delivery_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "tracking_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "kucibok_id",
			"value": "KCB-00000001",
			"type": "string"
		},
		{
			"key": "blog_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "subscription_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "user_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Setup",
			"description": "Run Sign In first to populate auth_token for all subsequent requests.",
			"item": [
				{
					"name": "Sign In (saves auth_token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has data with session', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json).to.have.property('data');",
									"    pm.expect(json.data).to.have.property('session');",
									"});",
									"",
									"const json = pm.response.json();",
									"if (json.data && json.data.session && json.data.session.access_token) {",
									"    pm.environment.set('auth_token', json.data.session.access_token);",
									"    console.log('auth_token saved to environment.');",
									"}",
									"if (json.data && json.data.user && json.data.user.id) {",
									"    pm.collectionVariables.set('user_id', json.data.user.id);",
									"    pm.collectionVariables.set('profile_id', json.data.user.id);",
									"    console.log('user_id and profile_id saved to collection variables.');",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"your-password-here\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/signin",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "signin"]
						},
						"description": "Signs in and saves the access_token to the environment variable `auth_token`. Update the email and password in the body before running."
					}
				}
			]
		},
