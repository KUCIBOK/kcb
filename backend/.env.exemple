# ============================================================
# TEMPLATE DE CONFIGURATION — COPIER EN .env ET REMPLIR
# CE FICHIER NE DOIT CONTENIR AUCUNE VALEUR RÉELLE
# ============================================================

# Environnement
NODE_ENV=development
ENV=development

# Port de l'application
PORT=3000

# Config API — clé partagée entre frontend et backend
API_URL=http://localhost:3000
API_KEY=CHANGE_ME_GENERATE_RANDOM_KEY_32_CHARS

# Domaine du backend
HOST=0.0.0.0

# URI MongoDB
# Local : mongodb://localhost:27017/kucibok
# Atlas  : mongodb+srv://USER:PASSWORD@cluster.mongodb.net/kucibok
MONGODB_URI=mongodb://localhost:27017/kucibok

# URL du cache Redis (optionnel en dev)
REDIS_URL=

# JWT — générer avec : openssl rand -hex 64
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARACTERS_RANDOM_STRING
JWT_EXPIRES_IN=1h

# Clé de chiffrement des wallets Ethereum
# Générer avec : openssl rand -hex 32
WALLET_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_HEX_STRING

# Origine des CORS (URL du frontend)
CORS_ORIGIN=http://localhost:5173

# Configuration Resend pour l'envoi des emails
RESEND_API_KEY=CHANGE_ME_YOUR_RESEND_API_KEY

# Configuration Hostinger pour l'envoi des emails
HOSTINGER_EMAIL_PASSWORD=CHANGE_ME_YOUR_EMAIL_PASSWORD

# Configuration SMTP (Brevo ou autre — optionnel)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=CHANGE_ME
# SMTP_PASS=CHANGE_ME

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Uploads
MAX_FILE_SIZE=10485760
UPLOAD_PATH=public/uploads

# PayDunya — TOUJOURS utiliser les clés SANDBOX en développement
PAYDUNYA_MASTER_KEY=CHANGE_ME_SANDBOX_MASTER_KEY
PAYDUNYA_PRIVATE_KEY=CHANGE_ME_SANDBOX_PRIVATE_KEY
PAYDUNYA_TOKEN=CHANGE_ME_SANDBOX_TOKEN
PAYDUNYA_MODE=sandbox
STORE_NAME=Kucibok
STORE_TAGLINE="Plateforme d'art africain"
STORE_PHONE=+221000000000
STORE_ADDRESS="Dakar, Sénégal"

# Logidoo — secret partagé pour l'authentification service-to-service
# Générer avec : openssl rand -hex 32
LOGIDOO_SERVICE_SECRET=CHANGE_ME_SHARED_SECRET_WITH_LOGIDOO

# Email administrateur
ADMIN_EMAIL=admin@example.com

# Niveau des logs (debug, info, warn, error)
LOG_LEVEL=info
