# ============================================================
# KUCIBOK — TEMPLATE CONFIGURATION BACKEND
# Copier ce fichier en .env et remplir chaque valeur.
# CE FICHIER NE DOIT JAMAIS CONTENIR DE VALEURS RÉELLES.
# .env est dans .gitignore — ne jamais le commiter.
# ============================================================

# ------------------------------------------------------------
# ENVIRONNEMENT
# ------------------------------------------------------------
# Valeurs possibles : development | production | test
NODE_ENV=development

# Port d'écoute du serveur Express (PM2 sur VPS Hostinger)
PORT=3000

# Interface réseau — 0.0.0.0 pour écouter sur toutes les interfaces (VPS)
HOST=0.0.0.0

# ------------------------------------------------------------
# API — CLÉ PARTAGÉE ENTRE FRONTEND ET BACKEND
# Chaque requête frontend doit inclure le header : kcb-api-key: <valeur>
# Générer avec : openssl rand -hex 32
# ------------------------------------------------------------
API_KEY=CHANGE_ME_GENERATE_RANDOM_KEY_32_CHARS

# URL publique du backend (utilisée dans les certificats PDF et les emails)
# Dev    : http://localhost:3000
# Prod   : https://backend.kucibok.com
API_URL=http://localhost:3000

# ------------------------------------------------------------
# MONGODB ATLAS
# Dashboard : https://cloud.mongodb.com
# Projet    : kucibok / Cluster : kucibok
# Format    : mongodb+srv://USER:PASSWORD@kucibok.mmnychn.mongodb.net/kucibok?retryWrites=true&w=majority
# Dev local : mongodb://localhost:27017/kucibok
# Droits minimaux du user Atlas : readWrite sur la base kucibok
# ------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/kucibok

# ------------------------------------------------------------
# REDIS — CACHE ET BLACKLIST JWT
# Optionnel en développement — OBLIGATOIRE en production.
# Sans Redis : le cache est désactivé et les tokens révoqués (logout)
# ne sont pas blacklistés côté serveur.
#
# Options :
#   Local dev  : redis://localhost:6379
#   Upstash    : rediss://default:PASSWORD@HOST.upstash.io:PORT
#   VPS local  : redis://127.0.0.1:6379  (Redis installé sur le même VPS)
# ------------------------------------------------------------
REDIS_URL=

# ------------------------------------------------------------
# JWT — AUTHENTIFICATION
# Générer les secrets avec : openssl rand -hex 64
# Les deux secrets DOIVENT être différents.
# Changer JWT_SECRET invalide TOUS les tokens actifs en production.
# ------------------------------------------------------------
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARACTERS_RANDOM_STRING
JWT_EXPIRES_IN=1h

REFRESH_TOKEN_SECRET=CHANGE_ME_MINIMUM_64_CHARACTERS_DIFFERENT_RANDOM_STRING
REFRESH_TOKEN_EXPIRES_IN=30d

# ------------------------------------------------------------
# CORS — ORIGINE AUTORISÉE
# Une seule origine (pas de virgule).
# Dev  : http://localhost:5173
# Prod : https://kucibok.com
# ------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# WALLETS ETHEREUM — CHIFFREMENT AES-256-GCM
# Protège les clés privées ETH stockées en base MongoDB.
# Générer avec : openssl rand -hex 32
# CRITIQUE : changer cette clé en prod rend tous les wallets illisibles.
# ------------------------------------------------------------
WALLET_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_HEX_STRING

# ------------------------------------------------------------
# CLOUDINARY — STOCKAGE DES IMAGES (CDN)
# Dashboard  : https://cloudinary.com/console
# Compte     : kucibok
# Les images sont stockées dans le dossier kucibok/uploads/
# En développement, utiliser le même compte avec un dossier dev/uploads/
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=CHANGE_ME_YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_ME_YOUR_API_KEY
CLOUDINARY_API_SECRET=CHANGE_ME_YOUR_API_SECRET

# ------------------------------------------------------------
# RESEND — SERVICE D'ENVOI D'EMAILS (SERVICE ACTIF)
# Dashboard  : https://resend.com/api-keys
# Domaine    : kucibok.com (à vérifier dans Resend si non fait)
# Utilisé pour : vérification email, bienvenue, réinitialisation MDP,
#                certificats, factures, alertes admin, campagnes email.
# En dev, utiliser le domaine sandbox Resend (onboarding@resend.dev).
# ------------------------------------------------------------
RESEND_API_KEY=CHANGE_ME_YOUR_RESEND_API_KEY

# ------------------------------------------------------------
# SMTP — UNIQUEMENT POUR LES CAMPAGNES EMAIL (campaign.controller.js)
# Nodemailer est utilisé dans le module Campagnes pour l'envoi en masse.
# Tout le reste des emails passe par Resend (cf. ci-dessus).
#
# Options testées :
#   Hostinger SMTP  : smtp.hostinger.com  port 465  (SSL)
#   Gmail (test)    : smtp.gmail.com      port 587  (TLS)
#   Ethereal (dev)  : smtp.ethereal.email port 587  (mock, aucun email réel)
# ------------------------------------------------------------
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD

# ------------------------------------------------------------
# EMAILS ADMINISTRATEUR
# ADMIN_EMAIL   : expéditeur par défaut pour les mails Resend (mailer.service.js)
# ALERT_RECEIVER: destinataire des alertes serveur (watchdog + erreurs JS frontend)
# ------------------------------------------------------------
ADMIN_EMAIL=admin@kucibok.com
ALERT_RECEIVER=admin@kucibok.com

# ------------------------------------------------------------
# RATE LIMITING — PROTECTION DOS
# RATE_LIMIT_WINDOW_MS  : fenêtre temporelle en ms (défaut : 900000 = 15 min)
# RATE_LIMIT_MAX_REQUESTS : max requêtes par IP dans la fenêtre (défaut : 100)
# L'endpoint /api/report-error a son propre limiteur : 5 req / 15 min.
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------
# UPLOADS — FICHIERS LOCAUX (TEMPORAIRE)
# Stockage local sur le VPS Hostinger dans public/uploads/.
# Migration prévue vers Cloudinary ou S3 (Phase 2 — P2-ARCH-006).
# MAX_FILE_SIZE en octets (défaut : 10485760 = 10 Mo)
# Types acceptés : JPEG, PNG, WebP (validés par magic bytes, pas par extension)
# ------------------------------------------------------------
MAX_FILE_SIZE=10485760
UPLOAD_PATH=public/uploads

# ------------------------------------------------------------
# PAYDUNYA — PAIEMENTS AFRIQUE DE L'OUEST
# Dashboard  : https://app.paydunya.com
# Compte     : kucibok (Sénégal)
# IMPORTANT  : utiliser les clés SANDBOX en développement.
#              Les clés LIVE ne doivent exister que dans .env de production.
#
# Où trouver les clés (sandbox) :
#   Connexion → Paramètres → Clés API → Mode Test
# Où trouver les clés (live) :
#   Connexion → Paramètres → Clés API → Mode Production
#
# PAYDUNYA_MODE : sandbox (dev/staging) | production (prod uniquement)
#
# Webhook de callback à configurer dans le dashboard PayDunya :
#   https://backend.kucibok.com/api/payments/paydunya/callback
# Vérification HMAC SHA-512 avec PAYDUNYA_MASTER_KEY (activée côté backend).
# ------------------------------------------------------------
PAYDUNYA_MASTER_KEY=CHANGE_ME_SANDBOX_MASTER_KEY
PAYDUNYA_PRIVATE_KEY=CHANGE_ME_SANDBOX_PRIVATE_KEY
PAYDUNYA_TOKEN=CHANGE_ME_SANDBOX_TOKEN
PAYDUNYA_MODE=sandbox
PAYDUNYA_STORE_NAME=Kucibok
PAYDUNYA_STORE_TAGLINE=Plateforme d'art africain certifié
PAYDUNYA_STORE_PHONE=+221000000000
PAYDUNYA_STORE_ADDRESS=Dakar, Sénégal

# ------------------------------------------------------------
# LOGIDOO — INTÉGRATION LOGISTIQUE TRANSFRONTALIÈRE
# API de gestion des expéditions d'œuvres d'art (corridors AF↔FR).
# Dashboard  : https://expedition.logidoo.co  (prod)
#              https://staging-expedition.logidoo.co (staging)
#
# Où trouver la clé API :
#   Connexion au dashboard Logidoo → Paramètres → API Keys
#
# La clé est un JWT RSA256 de longue durée fourni par Logidoo.
# Elle est utilisée dans :
#   - logidoo.service.js : header Authorization: Bearer <clé>
#   - middleware/logidooAuth.js : validation des webhooks entrants Logidoo
#
# SÉCURITÉ CRITIQUE :
#   Ne jamais hardcoder ce token dans le code source (cf. P0-SEC-003).
#   La valeur ici remplace la constante hardcodée dans logidooAuth.js.
# ------------------------------------------------------------
LOGIDOO_API_KEY=CHANGE_ME_LOGIDOO_JWT_TOKEN

# ------------------------------------------------------------
# PDF — GÉNÉRATION CERTIFICATS ET FACTURES (Puppeteer / html-pdf-node)
# Sur VPS Hostinger Ubuntu, Chromium doit être installé manuellement.
# Installation : sudo snap install chromium  (ou apt selon la distro)
#
# CHROME_BIN : chemin vers le binaire Chromium système.
#   Snap   : /snap/bin/chromium
#   Apt    : /usr/bin/chromium-browser  ou  /usr/bin/google-chrome
# Laisser vide en développement (Puppeteer utilise son Chromium bundlé).
#
# Vérifier que le chemin est correct avec : which chromium
# ------------------------------------------------------------
CHROME_BIN=/snap/bin/chromium

# ------------------------------------------------------------
# LOGS — WINSTON
# Niveaux disponibles : error | warn | info | http | debug
# Production : info (éviter debug qui est verbeux)
# Développement : debug
# ------------------------------------------------------------
LOG_LEVEL=info
