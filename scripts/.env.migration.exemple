# =============================================================
# KUCIBOK — TEMPLATE CONFIGURATION SCRIPTS DE MIGRATION
# Copier ce fichier en .env.migration et remplir chaque valeur.
# CE FICHIER NE DOIT JAMAIS CONTENIR DE VALEURS REELLES.
# .env.migration est dans .gitignore — ne jamais le commiter.
# =============================================================

# ------------------------------------------------------------
# MONGODB ATLAS — BASE SOURCE (pre-migration)
# URI de connexion Atlas avec credentials.
# Format : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
# Recuperer depuis : Atlas dashboard → Connect → Drivers
# IMPORTANT : utiliser un user read-only pour les migrations.
# ------------------------------------------------------------
MONGODB_URI=mongodb+srv://CHANGE_ME:CHANGE_ME@cluster0.xxxxx.mongodb.net/kucibok

# ------------------------------------------------------------
# SUPABASE — BASE CIBLE (post-migration)
# URL du projet Supabase.
# Recuperer depuis : Supabase dashboard → Settings → API → Project URL
# ------------------------------------------------------------
SUPABASE_URL=https://CHANGE_ME.supabase.co

# ------------------------------------------------------------
# SUPABASE SERVICE ROLE KEY — CLE ADMIN (serveur uniquement)
# Autorise toutes les operations (bypass RLS).
# JAMAIS exposer cote client. Jamais commiter.
# Recuperer depuis : Supabase dashboard → Settings → API → service_role key
# ------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.CHANGE_ME

# ------------------------------------------------------------
# RESEND — EMAILS DE REINITIALISATION (optionnel)
# Utilise uniquement si --send-reset-emails est passe
# a migrate_users_auth.js pour notifier les users migres.
# ------------------------------------------------------------
RESEND_API_KEY=re_CHANGE_ME
