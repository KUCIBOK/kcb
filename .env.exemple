# ============================================================
# KUCIBOK — TEMPLATE CONFIGURATION COMPLET (local + vercel dev)
# Copier ce fichier en .env et remplir chaque valeur.
# CE FICHIER NE DOIT JAMAIS CONTENIR DE VALEURS RÉELLES.
# .env est dans .gitignore — ne jamais le commiter.
#
# IMPORTANT :
#   - Variables VITE_* → exposées dans le bundle JS côté client.
#     Ne jamais y mettre de secrets privés.
#   - Variables sans préfixe → côté serveur uniquement (Vercel Functions).
#     Disponibles via process.env dans api/
#     Pour vercel dev, elles sont lues depuis ce fichier .env.
# ============================================================


# ============================================================
# A) VARIABLES SERVEUR — Vercel Functions (process.env.VAR)
#    En production : configurer dans Vercel Dashboard → Settings → Env Vars
#    En local      : lues depuis .env via vercel dev
# ============================================================

# ------------------------------------------------------------
# SUPABASE — côté serveur
# Dashboard : https://supabase.com/dashboard → Settings → API
# ------------------------------------------------------------
SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...SERVICE_ROLE_KEY_ICI...
SUPABASE_ANON_KEY=eyJ...ANON_KEY_ICI...

# ------------------------------------------------------------
# API KEY INTERNE — clé partagée frontend ↔️ Vercel Functions
# Doit correspondre EXACTEMENT à VITE_API_KEY ci-dessous.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------
API_KEY=GENERER_UNE_CLE_ALEATOIRE_64_CHARS_HEX

# ------------------------------------------------------------
# CORS — Origine autorisée pour les Vercel Functions
# Production : https://kucibok.com
# Preview    : https://kucibok-wine.vercel.app
# Dev local  : http://localhost:5173
# ------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# RESEND — Emails transactionnels
# Dashboard : https://resend.com/api-keys
# ------------------------------------------------------------
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# EMAILS — Adresses système
# ------------------------------------------------------------
ADMIN_EMAIL=admin@kucibok.com
ALERT_RECEIVER=alerts@kucibok.com

# ------------------------------------------------------------
# PAYDUNYA — Paiement Mobile Money (West Africa)
# Dashboard : https://app.paydunya.com → Paramètres → API
# PAYDUNYA_MODE : "test" (sandbox) ou "live" (production réelle)
# ------------------------------------------------------------
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=PAYDUNYA_MASTER_KEY_ICI
PAYDUNYA_PRIVATE_KEY=PAYDUNYA_PRIVATE_KEY_ICI
PAYDUNYA_TOKEN=PAYDUNYA_TOKEN_ICI

# ------------------------------------------------------------
# LOGIDOO — API Logistique transfrontalière (West Africa ↔️ Europe)
# Dashboard : https://logidoo.africa → Développeurs → API Keys
# LOGIDOO_ENV : "sandbox" ou "production"
# ------------------------------------------------------------
LOGIDOO_API_KEY=LOGIDOO_JWT_TOKEN_ICI
LOGIDOO_ENV=sandbox


# ============================================================
# B) VARIABLES CLIENT — Bundle React (import.meta.env.VITE_VAR)
#    VISIBLES dans le JavaScript public — ne jamais y mettre de secrets.
# ============================================================

# ------------------------------------------------------------
# API — URL de base et clé partagée
# VITE_API_URL  : toujours /api en production (proxy Vercel).
# VITE_API_KEY  : doit correspondre EXACTEMENT à API_KEY ci-dessus.
# ------------------------------------------------------------
VITE_API_URL=/api
VITE_API_KEY=GENERER_UNE_CLE_ALEATOIRE_64_CHARS_HEX

# ------------------------------------------------------------
# DEV UNIQUEMENT — URL réelle du backend pour le proxy Vite
# Si vercel dev : laisser vide. Si yarn dev seul : http://localhost:3000
# ------------------------------------------------------------
VITE_DEV_BACKEND_URL=http://localhost:3000

# ------------------------------------------------------------
# SUPABASE — côté client (anon key uniquement — SAFE)
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...ANON_KEY_ICI...

# ------------------------------------------------------------
# GOOGLE OAUTH — Connexion Google
# Dashboard : https://console.cloud.google.com
# → APIs & Services → Identifiants → ID client OAuth 2.0
# URI de redirection : https://VOTRE_PROJECT_ID.supabase.co/auth/v1/callback
# Activer le provider : Supabase Dashboard → Auth → Providers → Google
# ------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=XXXXXXXXXXXXX.apps.googleusercontent.com

# ------------------------------------------------------------
# SENTRY — Monitoring des erreurs frontend
# Dashboard : https://sentry.io → Settings → Projects → Client Keys (DSN)
# Laisser vide pour désactiver en développement local.
# ------------------------------------------------------------
VITE_SENTRY_DSN=https://XXXX@oXXX.ingest.sentry.io/XXXX

# ------------------------------------------------------------
# MAINTENANCE — Bascule page de maintenance (RUNBOOK M4 Etape 1)
# ------------------------------------------------------------
VITE_MAINTENANCE_MODE=false


# ============================================================
# C) VARIABLES NON ACTIVES — Prévues phases futures
# ============================================================

# STRIPE — Paiements carte bancaire (Europe — Phase 2)
# STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
# VITE_STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX

# WEBSOCKET — Enchères temps réel (Phase 3)
# VITE_SOCKET_URL=http://localhost:3000

# INTOUCH / WAVE — Mobile Money alternatif (optionnel)
# VITE_INTOUCH_AGENCY_CODE=CHANGE_ME
# VITE_INTOUCH_SECURITY_CODE=CHANGE_ME
