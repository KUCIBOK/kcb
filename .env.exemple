# ============================================================
# KUCIBOK — TEMPLATE CONFIGURATION FRONTEND (Vite / React)
# Copier ce fichier en .env et remplir chaque valeur.
# CE FICHIER NE DOIT JAMAIS CONTENIR DE VALEURS RÉELLES.
# .env est dans .gitignore — ne jamais le commiter.
#
# IMPORTANT : toutes les variables VITE_ sont exposées dans le bundle
# JavaScript côté client. Ne jamais y mettre de secrets privés.
# ============================================================

# ------------------------------------------------------------
# API — URL DE BASE
# Toujours utiliser la valeur relative /api en production.
# Le proxy Vercel (vercel.json) redirige /api/* → backend.kucibok.com/api/*
# Le proxy Vite (vite.config.js) redirige /api/* → VITE_DEV_BACKEND_URL en dev.
#
# Ne PAS changer cette valeur pour la production.
# ------------------------------------------------------------
VITE_API_URL=/api

# ------------------------------------------------------------
# API KEY — CLÉ PARTAGÉE AVEC LES VERCEL FUNCTIONS
# Doit correspondre EXACTEMENT à API_KEY dans Vercel Dashboard.
# Envoyée dans le header HTTP : kcb-api-key: <valeur>
# via utils.options dans src/api/useAPI.js (getter dynamique).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------
VITE_API_KEY=CHANGE_ME_SAME_AS_API_KEY_IN_VERCEL_DASHBOARD

# ------------------------------------------------------------
# DEV UNIQUEMENT — URL RÉELLE DU BACKEND
# Utilisée par vite.config.js pour configurer le proxy de développement.
# Ne PAS définir en production (Vercel gère le proxy lui-même).
#
# Si le backend tourne en local : http://localhost:3000
# Si le backend est sur le VPS Hostinger en dev : https://backend.kucibok.com
# ------------------------------------------------------------
VITE_DEV_BACKEND_URL=http://localhost:3000

# ------------------------------------------------------------
# WEBSOCKET — ENCHÈRES EN TEMPS RÉEL (Phase 3 — non actif)
# URL du serveur Socket.io pour les enchères en direct.
# Actuellement non utilisé (enchères masquées côté front).
# Dev  : http://localhost:3000
# Prod : https://backend.kucibok.com
# ------------------------------------------------------------
VITE_SOCKET_URL=http://localhost:3000

# ------------------------------------------------------------
# GOOGLE OAUTH — CONNEXION GOOGLE
# Créer un Client ID sur : https://console.cloud.google.com
# → APIs & Services → Identifiants → Créer des identifiants → ID client OAuth 2.0
# Type d'application : Application Web
# Origines JavaScript autorisées :
#   - http://localhost:5173  (dev)
#   - https://kucibok.com    (prod)
# URI de redirection autorisés :
#   - http://localhost:5173  (dev)
#   - https://kucibok.com    (prod)
# ------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_OAUTH_CLIENT_ID

# ------------------------------------------------------------
# SUPABASE — STACK CIBLE (Migration Mars 2026)
# Remplace : JWT custom + MongoDB Atlas + Cloudinary + Redis
# Dashboard : https://supabase.com/dashboard → Settings → API
#
# VITE_SUPABASE_URL     : Project URL (ex: https://xxxx.supabase.co)
# VITE_SUPABASE_ANON_KEY: Clé publique anon/public — SAFE côté client
#
# IMPORTANT : ne jamais mettre la service_role key ici (secret côté serveur uniquement).
# La service_role key va dans les Vercel Functions (variables d'env serveur, non préfixées VITE_).
# ------------------------------------------------------------
VITE_SUPABASE_URL=CHANGE_ME_YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=CHANGE_ME_YOUR_SUPABASE_ANON_KEY

# ------------------------------------------------------------
# MAINTENANCE — M4 BASCULE PRODUCTION
# Mettre à true pendant la migration production (RUNBOOK M4 Etape 1).
# Affiche une page de maintenance à tous les visiteurs.
# Remettre à false (ou supprimer) après la validation post-migration.
# ------------------------------------------------------------
VITE_MAINTENANCE_MODE=false

# ------------------------------------------------------------
# INTOUCH / WAVE — PAIEMENT MOBILE MONEY (optionnel)
# Utilisé si le module InTouch est activé (non actif par défaut).
# Récupérer depuis le dashboard InTouch.
# ------------------------------------------------------------
VITE_INTOUCH_AGENCY_CODE=CHANGE_ME
VITE_INTOUCH_SECURITY_CODE=CHANGE_ME
